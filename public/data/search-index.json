[{"type":"course","id":"mod-linux-shell-c-1","title":"Linux 文件系统、权限模型与文本三剑客","summary":"掌握目录树结构、rwx/chmod/chown 与 SUID 权限边界，熟练使用 grep/sed/awk + 管道高效分析 GB 级日志。","url":"/courses/course-1","tags":["Linux权限","grep","awk","sed"]},{"type":"course","id":"mod-linux-shell-c-2","title":"Shell 健壮脚本工程与自动化运维","summary":"掌握 Bash 严格模式（set -euo pipefail）、安全引号与数组处理、trap 清理钩子以及 cron/systemd 定时任务。","url":"/courses/course-2","tags":["Bash严格模式","trap","systemd","Shell脚本"]},{"type":"course","id":"mod-linux-shell-c-3","title":"进程管理、systemd 服务与 SSH 安全访问","summary":"精通信号（SIGTERM/SIGKILL/SIGHUP）、编写自定义 systemd Unit 服务，以及 SSH 密钥登录与端口转发隧道。","url":"/courses/course-3","tags":["systemd","进程信号","SSH隧道","安全加固"]},{"type":"course","id":"mod-linux-shell-c-4","title":"Linux 线上性能排查与磁盘/网络诊断","summary":"建立 CPU、内存、磁盘 IO 与网络四维排查体系，快速定位 Load 飙高、Inode 耗尽、已删文件占空间与端口占用。","url":"/courses/course-4","tags":["性能排查","Load Average","磁盘IO","ss与lsof"]},{"type":"lesson","id":"mod-linux-shell-l-1","title":"Linux 目录结构、权限位与最小权限规范","summary":"分清普通文件与目录 `r/w/x` 权限的本质区别，理解 `umask` 与为什么生产环境严禁随手 `chmod 777`。","url":"/lessons/lesson-1-1","tags":[]},{"type":"lesson","id":"mod-linux-shell-l-2","title":"日志分析三剑客：grep、sed、awk 与管道组合","summary":"用一行管道命令在 3 秒内统计 Nginx/应用日志中 Top 10 报错接口、5xx 状态码占比与慢请求分布。","url":"/lessons/lesson-1-2","tags":[]},{"type":"lesson","id":"mod-linux-shell-l-3","title":"写出不翻车的生产级 Bash：严格模式与安全引号","summary":"用 `set -euo pipefail`、`\"$var\"` 双引号保护与 `trap` 清理钩子，消除 Shell 脚本最常见的静默失败与误删灾难。","url":"/lessons/lesson-2-1","tags":[]},{"type":"lesson","id":"mod-linux-shell-l-4","title":"重定向、xargs 并发与自动化定时任务","summary":"分清 `2>&1` 顺序含义、用 `find -print0 | xargs -0 -P` 安全并发批处理文件，以及用 `flock` 防止定时任务重叠执行。","url":"/lessons/lesson-2-2","tags":[]},{"type":"lesson","id":"mod-linux-shell-l-5","title":"进程信号与自定义 systemd 守护服务","summary":"理解 `SIGTERM (15)` 与 `SIGKILL (9)` 的区别，手写带自动重启、资源限制与 journald 日志的 systemd Unit。","url":"/lessons/lesson-3-1","tags":[]},{"type":"lesson","id":"mod-linux-shell-l-6","title":"SSH 密钥体系、跳板机 ProxyJump 与端口转发","summary":"配置 Ed25519 免密登录与 `~/.ssh/config` 跳板机直连，用本地端口转发安全访问内网数据库而无需暴露公网端口。","url":"/lessons/lesson-3-2","tags":[]},{"type":"lesson","id":"mod-linux-shell-l-7","title":"Linux 性能排查 60 秒黄金命令流（CPU / 内存 / Load）","summary":"读懂 Load Average 与 CPU 使用率的关系（高 Load 低 CPU 往往是 IO 等待），按标准顺序 1 分钟锁定瓶颈维度。","url":"/lessons/lesson-4-1","tags":[]},{"type":"lesson","id":"mod-linux-shell-l-8","title":"磁盘满、Inode 耗尽与端口占用经典排障","summary":"解决“删了大日志但 `df -h` 空间没释放”、“空间还剩 50% 却报 No space left on device”以及快速查端口进程。","url":"/lessons/lesson-4-2","tags":[]},{"type":"knowledge","id":"lx-kp-0001","title":"Linux","summary":"自由开放源代码的操作系统","url":"/knowledge/linux","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0002","title":"Ubuntu","summary":"基于Debian的Linux发行版","url":"/knowledge/ubuntu","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0003","title":"Shell","summary":"命令解释器用户与内核的接口","url":"/knowledge/shell","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0004","title":"Bash","summary":"Bourne Again Shell最常用的Shell","url":"/knowledge/bash","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0005","title":"终端","summary":"命令行交互界面","url":"/knowledge/终端","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0006","title":"文件系统","summary":"组织和管理文件的方式","url":"/knowledge/文件系统","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0007","title":"FHS","summary":"文件系统层次结构标准","url":"/knowledge/fhs","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0008","title":"绝对路径","summary":"从根/开始的完整路径","url":"/knowledge/绝对路径","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0009","title":"相对路径","summary":"相对当前目录的路径","url":"/knowledge/相对路径","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0010","title":"ls","summary":"列出目录内容","url":"/knowledge/ls","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0011","title":"cd","summary":"切换工作目录","url":"/knowledge/cd","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0012","title":"pwd","summary":"显示当前工作目录","url":"/knowledge/pwd","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0013","title":"mkdir","summary":"创建目录","url":"/knowledge/mkdir","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0014","title":"rm","summary":"删除文件或目录","url":"/knowledge/rm","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0015","title":"cp","summary":"复制文件或目录","url":"/knowledge/cp","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0016","title":"mv","summary":"移动或重命名","url":"/knowledge/mv","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0017","title":"touch","summary":"创建空文件或更新时间","url":"/knowledge/touch","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0018","title":"cat","summary":"查看文件内容","url":"/knowledge/cat","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0019","title":"less","summary":"分页查看文件","url":"/knowledge/less","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0020","title":"head","summary":"查看文件开头","url":"/knowledge/head","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0021","title":"tail","summary":"查看文件结尾","url":"/knowledge/tail","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0022","title":"grep","summary":"搜索文本模式","url":"/knowledge/grep","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0023","title":"sed","summary":"流编辑器进行文本替换","url":"/knowledge/sed","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0024","title":"awk","summary":"文本处理编程语言","url":"/knowledge/awk","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0025","title":"sort","summary":"排序文本","url":"/knowledge/sort","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0026","title":"uniq","summary":"去重相邻重复行","url":"/knowledge/uniq","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0027","title":"wc","summary":"统计行数字单词数","url":"/knowledge/wc","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0028","title":"chmod","summary":"修改文件权限","url":"/knowledge/chmod","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0029","title":"chown","summary":"修改文件所有者","url":"/knowledge/chown","tags":["Linux"]},{"type":"knowledge","id":"lx-kp-0030","title":"sudo","summary":"以超级用户执行命令","url":"/knowledge/sudo","tags":["Linux"]}